    using System;
    using System.Collections.Generic;
    using System.Linq;
    using System.Text;
    using System.Threading.Tasks;

    namespace Program70
    {
    internal class Program
    {
        static void Main() 
        {
            // Массив int: все элементы = default(int) → 0
            int[] nums = new int[4];

            // Массив string: все элементы = default(string) → null
            string[] words = new string[3];

            Console.Write("int[]: ");
            foreach (var n in nums)
                Console.Write(n + " "); // 0 0 0 0
            Console.WriteLine();

            Console.Write("string[]: ");
            foreach (var w in words)
                Console.Write((w == null ? "null" : w) + " "); // null null null
            Console.WriteLine();

            // Явная инициализация через default — полезно для читаемости
            int x = default(int);
            string s = default(string);

            Console.WriteLine($"x = {x}, s = {(s == null ? "null" : s)}");
        }
    }
    }
